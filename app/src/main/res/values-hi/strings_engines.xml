    <!-- CloudApiScreen -->
    <string name="engines_cloud_intro">ये वॉइस किसी प्रोवाइडर के सर्वर पर बनती हैं — हर अनुरोध के साथ आपका टेक्स्ट नेटवर्क पर भेजा जाता है। किसी भी प्रोवाइडर की वॉइस इस्तेमाल करने के लिए उसकी कुंजी जोड़ें; हर प्रोवाइडर आपके अपने खाते से बिलिंग करता है।</string>
    <string name="engines_cloud_disclaimer_title">क्लाउड वॉइस इस्तेमाल करने से पहले</string>
    <string name="engines_cloud_disclaimer_leaves_title">आपका टेक्स्ट इस डिवाइस से बाहर जाता है</string>
    <string name="engines_cloud_disclaimer_leaves_body">Marmalade की बिल्ट-इन वॉइस पूरी तरह आपके फ़ोन पर ही चलती हैं और कहीं कुछ नहीं भेजतीं। क्लाउड वॉइस इसका अपवाद हैं: जो टेक्स्ट आप उन्हें पढ़ने के लिए देते हैं, वह पूरा का पूरा आपके चुने हुए प्रोवाइडर को भेजा जाता है — वॉइस, मॉडल, स्पीड और आपकी API कुंजी के साथ।</string>
    <string name="engines_cloud_disclaimer_rules_title">वहाँ उनके नियम चलते हैं, हमारे नहीं</string>
    <string name="engines_cloud_disclaimer_rules_body">वह प्रोवाइडर क्या लॉग करता है, आपका टेक्स्ट कितने समय तक रखता है, और उस पर ट्रेनिंग करता है या नहीं — यह सब उसकी प्राइवेसी पॉलिसी और शर्तों से तय होता है, जिन्हें आप खाता बनाते समय सीधे उसके साथ स्वीकार करते हैं।</string>
    <string name="engines_cloud_disclaimer_affiliation_title">उनसे हमारा कोई संबंध नहीं है</string>
    <string name="engines_cloud_disclaimer_affiliation_body">Marmalade स्वतंत्र है। किसी भी प्रोवाइडर का न हमें समर्थन है, न प्रायोजन, न कोई साझेदारी; हमें उनसे कुछ नहीं मिलता, और हम आपका इस्तेमाल न देख सकते हैं न उस पर कुछ कर सकते हैं — डेटा मिटाने के अनुरोध भी सीधे प्रोवाइडर को ही करने होंगे।</string>
    <string name="engines_cloud_disclaimer_other_apps_title">इसका असर दूसरे ऐप्स पर भी पड़ता है</string>
    <string name="engines_cloud_disclaimer_other_apps_body">Marmalade आपके पूरे फ़ोन की वॉइस बन सकता है। अगर आप किसी क्लाउड वॉइस को प्राथमिक बनाते हैं, या किसी ऐप को उस पर भेजते हैं, तो उन ऐप्स का टेक्स्ट भी — ईबुक, मैसेज, कुछ भी जो आपको पढ़कर सुनाया जाता है — उसी प्रोवाइडर को भेजा जाएगा। डिवाइस पर चलने वाली वॉइस पर इसका कोई असर नहीं होता।</string>
    <string name="engines_cloud_disclaimer_billing_title">पैसे उन्हें जाते हैं, हमें नहीं</string>
    <string name="engines_cloud_disclaimer_billing_body">आपके इस्तेमाल का बिल हर प्रोवाइडर आपके अपने खाते से लेता है। Marmalade खुद मुफ़्त है और इसमें से कुछ नहीं लेता।</string>
    <string name="engines_cloud_disclaimer_footer">यह सब प्राइवेसी पॉलिसी में भी है, जिसका लिंक सेटिंग → ऐप के बारे में में मिलेगा; वहाँ आप इसे कभी भी दोबारा पढ़ सकते हैं।</string>
    <string name="engines_cloud_disclaimer_agree">मैं समझ गया और सहमत हूँ</string>
    <string name="engines_cloud_disclaimer_decline">अभी नहीं</string>

