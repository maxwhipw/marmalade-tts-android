    <string name="onboarding_background_title_allowed">Background allowed</string>
    <string name="onboarding_background_title">Keep speaking with the screen off</string>
    <string name="onboarding_background_body_allowed">Marmalade is exempt from Android\'s battery restrictions. Synthesis won\'t be paused when the screen sleeps.</string>
    <string name="onboarding_background_body">Android pauses background apps when the screen sleeps or the battery dips low — that can cut off speech mid-sentence on long passages. Allowing Marmalade to run unrestricted keeps speech playing through screen-off.</string>
    <string name="onboarding_background_allow">Allow background activity</string>
    <string name="onboarding_skip_for_now">Skip — I\'ll do this later</string>
    <string name="onboarding_background_footnote">You can change this any time in Android Settings → Apps → Marmalade TTS → Battery.</string>

    <string name="onboarding_notifications_title_granted">Notifications on</string>
    <string name="onboarding_notifications_title">Show what Marmalade\'s doing</string>
    <string name="onboarding_notifications_body_granted">Marmalade can show its speaking and “keeping warm” notifications.</string>
    <string name="onboarding_notifications_body">Marmalade shows a small notification while it speaks, and another while it keeps an engine warm for instant replies (the default). Allow notifications so both can appear.</string>
    <string name="onboarding_notifications_allow">Allow notifications</string>
    <string name="onboarding_notifications_footnote">Only used for the speaking and keep-warm notifications. Change any time in Android Settings → Apps → Marmalade TTS → Notifications.</string>

    <string name="onboarding_system_title_done">All done!</string>
    <string name="onboarding_system_title">One more step</string>
    <string name="onboarding_system_body_done">Marmalade is your system text-to-speech engine. Other apps\' TTS now routes through your voices.</string>
    <string name="onboarding_system_body">To let other apps speak through Marmalade, you have to pick it as your system text-to-speech engine. Android won\'t route TTS to us until you do.</string>
    <string name="onboarding_system_hint">Tap the button below — most phones land directly on the right page. If yours doesn\'t, look for \"Text-to-speech\" under System → Languages, Accessibility → Audio, or Languages &amp; input.</string>
    <string name="onboarding_system_open_settings">Open system TTS settings</string>
    <string name="onboarding_system_finish_later">Finish — I\'ll do this later</string>
    <string name="onboarding_system_footnote">You can re-open this from Settings → Set as system TTS engine.</string>
    <string name="onboarding_finish">Finish</string>
