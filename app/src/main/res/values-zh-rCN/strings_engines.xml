    <!-- CloudApiScreen -->
    <string name="engines_cloud_intro">语音在服务商的服务器上合成 — 每次请求都会通过网络发送你的文本。为任一服务商添加密钥即可使用其语音；每家服务商都通过各自的账户计费。</string>
    <string name="engines_cloud_disclaimer_title">使用云端语音前请阅读</string>
    <string name="engines_cloud_disclaimer_leaves_title">你的文本会离开本设备</string>
    <string name="engines_cloud_disclaimer_leaves_body">Marmalade 的内置语音完全在手机本地运行，不会向任何地方发送数据。云端语音是例外：你要它朗读的文本会连同所请求的语音、模型、语速以及你的 API 密钥，完整传输给你选择的服务商。</string>
    <string name="engines_cloud_disclaimer_rules_title">适用的是他们的规则，不是我们的</string>
    <string name="engines_cloud_disclaimer_rules_body">该服务商记录什么、保存你的文本多久、是否用于训练，均由他们的隐私政策和条款约束 — 你在注册账户时就已直接与他们达成这些约定。</string>
    <string name="engines_cloud_disclaimer_affiliation_title">我们与他们没有关联</string>
    <string name="engines_cloud_disclaimer_affiliation_body">Marmalade 是独立的。我们未获任何服务商的背书、赞助或合作，也不从他们那里获得任何收益，更无法查看或干预你的使用情况 — 包括删除请求，那必须直接向服务商提出。</string>
    <string name="engines_cloud_disclaimer_other_apps_title">其他应用同样受影响</string>
    <string name="engines_cloud_disclaimer_other_apps_body">Marmalade 可以作为你的全系统语音。如果把云端语音设为主语音，或把某个应用指向它，那么这些应用的文本 — 电子书、消息，凡是朗读给你听的内容 — 也会被发送给该服务商。本机语音不受影响。</string>
    <string name="engines_cloud_disclaimer_billing_title">费用付给他们，不是我们</string>
    <string name="engines_cloud_disclaimer_billing_body">每家服务商都按用量向你自己的账户计费。Marmalade 本身免费，不抽取任何分成。</string>
    <string name="engines_cloud_disclaimer_footer">这些内容同样写在隐私政策中，可从“设置 → 关于”打开，随时再次查阅。</string>
    <string name="engines_cloud_disclaimer_agree">我已了解并同意</string>
    <string name="engines_cloud_disclaimer_decline">暂不使用</string>

