    <!-- SettingsScreen -->
    <string name="settings_title">设置</string>
    <string name="settings_back">返回</string>

    <string name="settings_appearance">外观</string>
    <string name="settings_mode">模式</string>
    <string name="settings_mode_system">跟随系统</string>
    <string name="settings_mode_light">浅色</string>
    <string name="settings_mode_dark">深色</string>
