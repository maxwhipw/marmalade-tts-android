    <string name="onboarding_alias_title">创建你的主别名</string>
    <string name="onboarding_alias_body">别名把你喜欢的语音、语速和音效归到一个名字下，例如“旁白”。当应用请求朗读却未指定语音时，Marmalade 就会使用主别名。至少创建一个别名以完成设置 — 之后可在“设置 → 语音别名”中添加更多。</string>
    <string name="onboarding_alias_name_label">名称</string>
    <string name="onboarding_alias_name_helper">可使用字母、数字、空格和连字符，最多 50 个字符。</string>
